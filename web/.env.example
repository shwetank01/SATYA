# Copy to web/.env.local (gitignored). Never commit real values: tools/secret_guard.py blocks them.

# App <-> gateway (scripts/gen-keys.ts fills these)
SATYA_APP_KEY=
SATYA_RECEIPT_SK=
SATYA_RECEIPT_PK=
SATYA_ROOT_PK=
NEXT_PUBLIC_SATYA_ROOT_PK=
SATYA_DOCTOR_BOX_SK=
SATYA_DOCTOR_BOX_PK=

# AI: Sarvam (https://dashboard.sarvam.ai). Server only; the app and browser never see it.
SARVAM_API_KEY=
# Optional overrides
# SARVAM_CHAT_MODEL=sarvam-105b
# SARVAM_STT_MODEL=saaras:v3

# Storage: a private Vercel Blob store (vercel blob create-store <name> --access private)
BLOB_READ_WRITE_TOKEN=

# NYAYA console sign-in: a shared password per deployment and a random secret that signs sessions
NYAYA_PASSWORD=
NYAYA_SECRET=

# Optional: VIVEK deepfake scoring service, and Supabase (Section 12 schema, used by scripts/seed.ts)
VIVEK_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
