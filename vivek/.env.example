# Copy to vivek/.env (gitignored). Values come from keys/server.json and the satya-ai worker URL.
SATYA_APP_KEY=
# SATYA's own Cloudflare Workers AI gateway (Qwen + Whisper). Any OpenAI-compatible URL works.
AI_BASE_URL=https://satya-ai.<your-subdomain>.workers.dev/v1
AI_API_KEY=
AI_CHAT_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
AI_STT_MODEL=@cf/openai/whisper-large-v3-turbo
